{
  "name": "house-crm",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "lint": "eslint src tests scripts *.ts",
    "test": "vitest run",
    "prebuild": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "starter:check": "node scripts/check-starter.mjs",
    "verify": "npm run test:publisher && npm run typecheck && npm run lint && npm test -- --maxWorkers=1 && npm run starter:check && node scripts/check-release.mjs --self-test && node scripts/check-release.mjs --source-only && npm run build && npm run release:check",
    "publish": "node publish.mjs",
    "test:publisher": "node --test scripts/publish-regression.mjs"
  },
